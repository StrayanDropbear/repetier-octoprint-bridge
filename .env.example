# Copy to .env and edit.

# Base URL of your Repetier-Server. Use a LAN IP, not 127.0.0.1, unless the
# container runs in host network mode on the same machine.
REPETIER_URL=http://192.168.0.50:3344

# Repetier-Server API key: Global settings -> API keys.
REPETIER_APIKEY=replace-me

# Maps the API token you type into your slicer to a Repetier printer slug.
# The tokens are arbitrary strings you invent; the slugs must match Repetier.
# List your slugs with:
#   curl "http://192.168.0.50:3344/printer/api?a=listPrinter&apikey=YOUR_KEY"
BRIDGE_KEYMAP={"token-a":"Printer_One","token-b":"Printer_Two"}

# Fallback printer when a request arrives with an unmapped token.
# Leave empty so unknown tokens are rejected instead of printing on the wrong machine.
REPETIER_SLUG=

# Rename uploads from metadata found in the G-code. Empty disables renaming.
BRIDGE_NAME_TEMPLATE={name}_{printer}_{material}_{nozzle}mm_{time}
BRIDGE_NAME_CASE=lower

# Optional extra shared token accepted alongside the mapped ones.
BRIDGE_REQUIRE_KEY=

# Port inside the container.
BRIDGE_PORT=5000
